{"ts":"2026-10-19T00:37:52.764875","pid":19664,"tid":"446c|mux t13","sev":"info","req":"8","sess":"mjr6frx7RQGCFx9ntQKQUQ","ctx":{"workload":{"name":"tableau-interactive"},"tenant-id":"-","user-agent":"{\"app\": \"Tableau\", \"edition\": \"pro\", \"version\": \"20262.26.0912.1023\"}","client":{"req":"RR-0f5g5zd10qf8771fovbgu1ooeb32","sess":"RS-067lly40zc8v1j119rlil1ujw8mo","site":"-","process":"tableau-desktop","user":"-","host":"DESKTOP-R07RLA8"}},"k":"query-begin","v":{"spooling":false,"query-settings-active":false,"query-hash":"1950.7d599d119401.c755f3","query":"SELECT c.contype, c.conname, a.attname, a.attnotnull, tns.relname, unnest_conkey, conkey_string, tns.nspname as ref_ns\n  FROM pg_catalog.pg_class cl\n  JOIN ( SELECT c.contype, unnest(c.conkey) AS unnest_conkey,\n                c.conname, c.confrelid, array_to_string(c.conkey, ',', '*') as conkey_string,\n                c.conrelid\n          FROM pg_catalog.pg_constraint c) c\n   ON c.conrelid = cl.oid\n  JOIN pg_catalog.pg_attribute a\n   ON  c.unnest_conkey = a.attnum\n   AND a.attrelid      = cl.oid\n  LEFT JOIN (\n    SELECT t.oid, t.relname, ns.nspname\n    FROM pg_catalog.pg_class t\n    JOIN pg_catalog.pg_namespace ns\n      ON ns.oid = t.relnamespace\n    WHERE t.relkind IN('r','v','f')\n     AND ns.nspname not like 'pg_catalog') tns\n  ON c.confrelid = tns.oid\n WHERE NOT a.attisdropped\n   AND cl.relname = 'Orders_ECFCA1FB690A41FE803BC071773BA862'\n   AND cl.relnamespace = 10004"}}
