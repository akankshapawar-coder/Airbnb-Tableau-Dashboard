e = a.attname AND s.tablename = 'Extract' AND s.schemaname = 'Extract'\n  WHERE a.attnum > 0\n   AND NOT a.attisdropped\n   AND cl.relname = 'Extract'\n   AND cl.relnamespace = 10004"}}
