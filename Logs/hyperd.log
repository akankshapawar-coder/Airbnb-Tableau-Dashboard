{"ts":"2026-10-24T12:26:24.410144","pid":23360,"tid":"40e8|mux t15","sev":"info","req":"8","sess":"xhgTq0DjSy-n2NVMxlso9w","ctx":{"workload":{"name":"tableau-interactive"},"tenant-id":"-","user-agent":"{\"app\": \"Tableau\", \"edition\": \"pro\", \"version\": \"20262.26.0912.1023\"}","client":{"req":"RR-1euwqld16igxl618hpbsk1uf6ylj","sess":"RS-17dc4il1t1b7q61fewrzk0vpa9ua","site":"-","process":"tableau-desktop","user":"-","host":"DESKTOP-R07RLA8"}},"k":"query-begin","v":{"spooling":false,"query-settings-active":false,"query-hash":"8027.7d599d119401.b84a3e","query":"SELECT c.contype, c.conname, a.attname, a.attnotnull, tns.relname, unnest_conkey, conkey_string, tns.nspname as ref_ns\n  FROM pg_catalog.pg_class cl\n  JOIN ( SELECT c.contype, unnest(c.conkey) AS unnest_conkey,\n                c.conname, c.confrelid, array_to_string(c.conkey, ',', '*') as conkey_string,\n                c.conrelid\n          FROM pg_catalog.pg_constraint c) c\n   ON c.conrelid = cl.oid\n  JOIN pg_catalog.pg_attribute a\n   ON  c.unnest_conkey = a.attnum\n   AND a.attrelid      = cl.oid\n  LEFT JOIN (\n    SELECT t.oid, t.relname, ns.nspname\n    FROM pg_catalog.pg_class t\n    JOIN pg_catalog.pg_namespace ns\n      ON ns.oid = t.relnamespace\n    WHERE t.relkind IN('r','v','f')\n     AND ns.nspname not like 'pg_catalog') tns\n  ON c.confrelid = tns.oid\n WHERE NOT a.attisdropped\n   AND cl.relname = 'Extract'\n   AND cl.relnamespace = 10004"}}
